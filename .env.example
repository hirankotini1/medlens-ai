# Nexus Pathology — Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# DO NOT commit real API keys or secrets to version control.

# OpenRouter AI Configuration (Optional decision-support enhancement)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Nexus Pathology AI Health Report Analyzer

# Application Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
