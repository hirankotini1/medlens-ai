# =============================================================================
# Avenqra AI — Environment Configuration Example
# =============================================================================
# Copy this file to .env and configure your environment variables.
# DO NOT commit real API keys or secrets to version control.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# ── OpenRouter AI Configuration ─────────────────────────────────────────────
# Required: Obtain your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Override default AI model (default: openrouter/free)
OPENROUTER_MODEL=openrouter/free

# Optional: Override follow-up question model (default: nex-agi/nex-n2.5-mini:free)
# OPENROUTER_FOLLOWUP_MODEL=nex-agi/nex-n2.5-mini:free

# Optional: Site URL sent in API request headers
OPENROUTER_SITE_URL=http://localhost:8000

# Optional: Application name sent in API request headers
OPENROUTER_APP_NAME=Avenqra AI Health Assistant

# ── Authentication Secrets ──────────────────────────────────────────────────
# Required: Used for pathology/patient token signing (HMAC-SHA256)
# MUST be a strong random string, unique per environment
PATHOLOGY_SECRET_KEY=

# Required: Used for staff/operations token signing (HMAC-SHA256)
# MUST be a strong random string, different from PATHOLOGY_SECRET_KEY
JWT_SECRET_KEY=

# ── Supabase PostgreSQL Configuration (Hospital ERP) ────────────────────────
# Required: Connection details for the hospital operations database
# (beds, admissions, staff auth, lab orders, billing)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# ── SMS Gateway Configuration (Android SIM Gateway) ─────────────────────────
# Required: Secret used to authenticate gateway devices and admin operations
SMS_GATEWAY_TOKEN_SECRET=
ADMIN_GATEWAY_TOKEN=

# Optional: Enable/disable SMS delivery (default: true)
SMS_GATEWAY_ENABLED=true

# Optional: Maximum SMS messages per day (default: 100)
SMS_DAILY_LIMIT=100

# ── Voice Case-Taking (Optional) ────────────────────────────────────────────
# Optional: Master switch for voice engine (default: true, uses browser Web Speech API)
# VOICE_ENABLED=true

# Optional: Bhashini Government AI platform for Indian languages
# BHASHINI_ENABLED=false
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=
# BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in

# Optional: AI4Bharat open-source Indian language ASR/TTS
# AI4BHARAT_ENABLED=false
# AI4BHARAT_API_KEY=
# AI4BHARAT_BASE_URL=https://api.ai4bharat.org
