<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MedLens Backend Connection"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server Base URL"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.1.100:8000"
            android:inputType="textUri"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Pairing Secret (from .env)"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_admin_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="medlens-sms-gateway-secret-2026"
            android:inputType="textPassword"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gateway Device Friendly Name"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ward 3 Nurse Station Phone"
            android:inputType="textCapWords"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Poll Interval (Seconds)"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/et_poll_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="30"
            android:inputType="number"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_device_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device ID: Loading..."
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_pairing_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Checking..."
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btn_test_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Connection &amp; Pair Device"
            android:backgroundTint="@color/accent"
            android:textColor="#ffffff"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_save_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:backgroundTint="@color/primary"
            android:textColor="#ffffff"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
