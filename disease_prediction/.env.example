# OpenRouter API Configuration for AI Health Report Analyzer
# Obtain your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Nexus Pathology AI Health Report Analyzer

# SMS Gateway Configuration (Android SIM Gateway)
# Set SMS_GATEWAY_ENABLED=true to enable the SMS delivery channel
SMS_GATEWAY_ENABLED=true
# Maximum SMS messages per day (matches your mobile plan)
SMS_DAILY_LIMIT=100
# One-time secret used to register Android gateway devices
# Change this to a strong random string before deploying!
SMS_GATEWAY_TOKEN_SECRET=change_this_to_a_strong_random_secret_before_deploying

# ==============================================================================
# MULTILINGUAL VOICE CASE-TAKING — SIH PS 26047
# ==============================================================================

# Master switch for voice engine (true/false)
VOICE_ENABLED=true

# Default language for voice sessions (BCP-47 code)
DEFAULT_VOICE_LANGUAGE=en-IN

# Provider selection — 'auto' tries providers in priority order
VOICE_PROVIDER=auto
TTS_PROVIDER=auto
STT_PROVIDER=auto

# TinyTTS — Optional English-only TTS
# Install: clone https://github.com/tronghieuit/tiny-tts
# NOTE: TinyTTS is for English ONLY. Do NOT use for Indian languages.
TINY_TTS_ENABLED=false

# BHASHINI — Government of India multilingual AI platform
# Obtain API key: https://bhashini.gov.in/
# Supports Hindi, Telugu, Tamil, Kannada, Malayalam, Bengali, Marathi, Gujarati, Punjabi, Odia, Assamese, Urdu
BHASHINI_ENABLED=false
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in

# AI4Bharat — Open-source Indian language ASR + TTS
# Obtain API key: https://ai4bharat.iitm.ac.in/
# Supports 22 Indian languages (IndicASR + IndicTTS)
AI4BHARAT_ENABLED=false
AI4BHARAT_API_KEY=your_ai4bharat_api_key_here
AI4BHARAT_BASE_URL=https://api.ai4bharat.org

# When no server-side provider is configured, the system automatically uses
# the browser Web Speech API (Chrome/Edge recommended for Indian languages).
# The SIH demo works in DEMO MODE with browser fallback — no API keys required.

